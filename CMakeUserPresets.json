{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../llvm-mos-sdk/install",
        "LLVM_MOS_PLATFORM": "rp6502",
        "Python3_FIND_VIRTUALENV": "FIRST",
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build",
      "configurePreset": "default"
    }
  ]
}
